!**/src/main/**/target/
!**/src/test/**/target/

# ===== Gradle 패턴 (사용 안 함이지만 안전을 위해 유지) =====
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

